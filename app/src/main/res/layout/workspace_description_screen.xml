<?xml version="1.0" encoding="utf-8"?>
<com.theteam.taskz.presentation.views.SplashRefreshLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    app:animation="loading"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".presentation.views.WorkspaceDescriptionScreen">
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/background"
        android:orientation="vertical">
        <com.google.android.material.appbar.AppBarLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/background"
            android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar">
            <com.google.android.material.appbar.CollapsingToolbarLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:titleCollapseMode="fade"
                app:contentScrim="?attr/background"
                app:title="Your Profile"
                app:layout_scrollFlags="scroll|exitUntilCollapsed">
                <!--I want this to be the collapsing appbar layout-->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_collapseMode="parallax"
                    android:orientation="vertical">
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <TextView
                            android:id="@+id/title_text"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text=""
                            android:paddingVertical="@dimen/medium_value_size"
                            android:gravity="center"
                            android:textSize="@dimen/medium_font_size"
                            android:textColor="?attr/colorPrimary"
                            android:fontFamily="@font/poppins_semibold"/>
                        <ImageView
                            android:id="@+id/back"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:src="@drawable/forward_icon"
                            app:tint="?attr/colorPrimary"
                            android:layout_marginLeft="@dimen/large_value_size"
                            android:rotation="180"
                            android:scaleY="0.8"
                            android:scaleX="0.8"
                            android:layout_alignParentStart="true"
                            android:layout_centerVertical="true"
                            android:scaleType="centerCrop"/>

                    </RelativeLayout>


                    <FrameLayout
                        android:id="@+id/profile_layout"
                        android:layout_width="90dp"
                        android:layout_gravity="center"
                        android:layout_height="90dp">
                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:gravity="center"
                            android:layout_height="match_parent">
                            <de.hdodenhof.circleimageview.CircleImageView
                                android:id="@+id/workspace_profile_icon"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:src="@color/workspacePlaceholder"
                                android:scaleType="centerCrop"/>
                            <ImageView
                                android:id="@+id/workspace_icon"
                                android:layout_width="45dp"
                                android:layout_height="45dp"
                                android:src="@drawable/collaboration"
                                android:scaleType="centerCrop"
                                android:layout_centerInParent="true"
                                app:tint="@color/white"/>
                            <ImageView
                                android:id="@+id/sub_icon"
                                android:layout_alignParentRight="true"
                                android:layout_alignParentBottom="true"
                                android:layout_width="31sp"
                                android:layout_height="31sp"
                                android:padding="@dimen/small_value_size"
                                android:background="@drawable/circle_background"
                                android:src="@drawable/add_plus"
                                android:scaleType="centerCrop"
                                android:gravity="center"
                                app:tint="@color/white"/>

                        </RelativeLayout>
                    </FrameLayout>

                    <TextView
                        android:id="@+id/workspace_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/medium_value_size"
                        android:text="Star Taskz Group"
                        android:textColor="?attr/colorPrimary"
                        android:textSize="14sp"
                        android:fontFamily="@font/poppins_bold"
                        android:layout_gravity="center"/>
                    <TextView
                        android:id="@+id/workspace_description"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Wokrspace for all Star Taskz Devs."
                        android:gravity="center"
                        android:layout_marginBottom="@dimen/regular_value_size"
                        android:textColor="?attr/colorSecondary"
                        android:textSize="11.5sp"
                        android:fontFamily="@font/poppins_medium"
                        android:layout_gravity="center"/>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/regular_value_size"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/logout_icon"
                            android:layout_gravity="center"
                            android:src="@drawable/logout"
                            app:tint="@color/red"
                            android:layout_width="50dp"
                            android:layout_height="50dp"
                            android:padding="13dp"
                            android:layout_marginHorizontal="@dimen/regular_value_size"
                            android:background="@drawable/circle_stroke" />
                        <ImageView
                            android:id="@+id/edit_icon"
                            android:src="@drawable/edit"
                            app:tint="@color/themeColor"
                            android:layout_width="50dp"
                            android:layout_height="50dp"
                            android:padding="13dp"
                            android:layout_marginHorizontal="@dimen/regular_value_size"
                            android:background="@drawable/circle_stroke" />
                        <ImageView
                            android:id="@+id/member_icon"
                            android:src="@drawable/add_member"
                            app:tint="@color/themeColor"
                            android:layout_width="50dp"
                            android:layout_height="50dp"
                            android:padding="13dp"
                            android:layout_marginHorizontal="@dimen/regular_value_size"
                            android:background="@drawable/circle_stroke" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_marginTop="@dimen/medium_value_size"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center">
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_gravity="center"
                            android:gravity="center"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Projects"
                                android:textColor="?attr/colorSecondary"
                                android:fontFamily="@font/poppins_medium"
                                android:textSize="9sp"/>
                            <TextView
                                android:id="@+id/projects"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="25"
                                android:textColor="?attr/colorPrimary"
                                android:textSize="16sp"
                                android:fontFamily="@font/poppins_bold"/>
                        </LinearLayout>
                        <View
                            android:layout_width="0.5dp"
                            android:layout_height="16dp"
                            android:background="@drawable/divider_drawable"
                            android:backgroundTint="?attr/colorSecondary"/>
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_gravity="center"
                            android:gravity="center"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Members"
                                android:textColor="?attr/colorSecondary"
                                android:fontFamily="@font/poppins_medium"
                                android:textSize="9sp"/>
                            <TextView
                                android:id="@+id/members"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="20"
                                android:textColor="?attr/colorPrimary"
                                android:textSize="16sp"
                                android:fontFamily="@font/poppins_bold"/>
                        </LinearLayout>
                        <View
                            android:layout_width="0.5dp"
                            android:layout_height="16dp"
                            android:background="@drawable/divider_drawable"
                            android:backgroundTint="?attr/colorSecondary"/>
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_gravity="center"
                            android:gravity="center"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Groups"
                                android:textColor="?attr/colorSecondary"
                                android:fontFamily="@font/poppins_medium"
                                android:textSize="9sp"/>
                            <TextView
                                android:id="@+id/groups"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="10"
                                android:textColor="?attr/colorPrimary"
                                android:textSize="16sp"
                                android:fontFamily="@font/poppins_bold"/>
                        </LinearLayout>

                    </LinearLayout>
                </LinearLayout>




            </com.google.android.material.appbar.CollapsingToolbarLayout>
            <!-- This tab bar isn't collapsed-->
            <com.google.android.material.tabs.TabLayout
                android:visibility="invisible"
                android:id="@+id/tab_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/large_value_size"
                android:layout_marginBottom="@dimen/small_value_size"
                android:paddingHorizontal="@dimen/regular_value_size"
                app:tabBackground="?attr/background"
                app:tabIndicator="@drawable/profile_tab_indicator"
                app:tabIndicatorColor="@color/themeColor"
                app:tabIndicatorFullWidth="false"
                app:tabSelectedTextAppearance="@style/TabSelectedText"
                app:tabTextAppearance="@style/TabUnselectedText"
                app:tabSelectedTextColor="@color/themeColor"
                app:tabTextColor="?attr/colorSecondary">

                <com.google.android.material.tabs.TabItem
                    android:id="@+id/tab_projects"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Projects"
                    android:textSize="16dp" />
                <com.google.android.material.tabs.TabItem
                    android:id="@+id/tab_members"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Members" />

                <com.google.android.material.tabs.TabItem
                    android:id="@+id/tab_group"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Groups" />


            </com.google.android.material.tabs.TabLayout>
        </com.google.android.material.appbar.AppBarLayout>
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabe_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/add_plus"
            app:backgroundTint="@color/themeColor"
            app:tint="@color/white"
            android:layout_margin="@dimen/medium_value_size"
            android:layout_gravity="bottom|right"/>

        <!--This is the layout containing the viewpager that contains the scrollable framents-->
        <androidx.viewpager2.widget.ViewPager2
            android:visibility="invisible"
            android:id="@+id/view_pager"
            android:background="@drawable/top_rounded_large"
            android:backgroundTint="?attr/colorTertiary"
            android:layout_width="match_parent"
            app:layout_behavior="@string/appbar_scrolling_view_behavior"
            android:layout_height="match_parent"/>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>


</com.theteam.taskz.presentation.views.SplashRefreshLayout>
