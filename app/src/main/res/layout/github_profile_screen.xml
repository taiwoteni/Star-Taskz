<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".presentation.views.GithubProfileScreen">
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <TextView
                android:id="@+id/title_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Github Profile"
                android:paddingVertical="@dimen/medium_value_size"
                android:gravity="center"
                android:textSize="@dimen/medium_font_size"
                android:textColor="?attr/colorPrimary"
                android:fontFamily="@font/poppins_semibold"/>
            <FrameLayout
                android:layout_gravity="center"
                android:layout_marginTop="@dimen/regular_value_size"
                android:id="@+id/profile_layout"
                android:layout_width="90dp"
                android:layout_height="90dp">
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <de.hdodenhof.circleimageview.CircleImageView
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:src="@drawable/avatar"
                        android:scaleY="1.5"
                        android:scaleX="1.5"
                        android:scaleType="centerCrop"
                        android:id="@+id/profile_icon"/>
                </RelativeLayout>
            </FrameLayout>
            <TextView
                android:id="@+id/name_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/medium_value_size"
                android:text="Teninlanimi Taiwo"
                android:textColor="?attr/colorPrimary"
                android:textSize="14sp"
                android:fontFamily="@font/poppins_bold"
                android:layout_gravity="center"/>
            <TextView
                android:id="@+id/username_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="taiwoteni"
                android:layout_marginBottom="@dimen/regular_value_size"
                android:textColor="?attr/colorSecondary"
                android:textSize="11.5sp"
                android:fontFamily="@font/poppins_medium"
                android:layout_gravity="center"/>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/regular_value_size"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/email_icon"
                    android:layout_gravity="center"
                    android:src="@drawable/email"
                    app:tint="@color/themeColor"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:padding="13dp"
                    android:layout_marginHorizontal="@dimen/regular_value_size"
                    android:background="@drawable/circle_stroke" />
                <ImageView
                    android:id="@+id/link_icon"
                    android:src="@drawable/link"
                    app:tint="@color/themeColor"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:padding="13dp"
                    android:layout_marginHorizontal="@dimen/regular_value_size"
                    android:background="@drawable/circle_stroke" />
                <ImageView
                    android:id="@+id/open_icon"
                    android:src="@drawable/open_link"
                    app:tint="@color/themeColor"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:padding="13dp"
                    android:layout_marginHorizontal="@dimen/regular_value_size"
                    android:background="@drawable/circle_stroke" />
            </LinearLayout>
            <LinearLayout
                android:layout_marginTop="@dimen/medium_value_size"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center">
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Followers"
                        android:textColor="?attr/colorSecondary"
                        android:fontFamily="@font/poppins_medium"
                        android:textSize="9sp"/>
                    <TextView
                        android:id="@+id/followers"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="25"
                        android:textColor="?attr/colorPrimary"
                        android:textSize="16sp"
                        android:fontFamily="@font/poppins_bold"/>
                </LinearLayout>
                <View
                    android:layout_width="0.5dp"
                    android:layout_height="16dp"
                    android:background="@drawable/divider_drawable"
                    android:backgroundTint="?attr/colorSecondary"/>
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Following"
                        android:textColor="?attr/colorSecondary"
                        android:fontFamily="@font/poppins_medium"
                        android:textSize="9sp"/>
                    <TextView
                        android:id="@+id/following"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="20"
                        android:textColor="?attr/colorPrimary"
                        android:textSize="16sp"
                        android:fontFamily="@font/poppins_bold"/>
                </LinearLayout>
                <View
                    android:layout_width="0.5dp"
                    android:layout_height="16dp"
                    android:background="@drawable/divider_drawable"
                    android:backgroundTint="?attr/colorSecondary"/>
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Public Repos"
                        android:textColor="?attr/colorSecondary"
                        android:fontFamily="@font/poppins_medium"
                        android:textSize="9sp"/>
                    <TextView
                        android:id="@+id/repos"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="10"
                        android:textColor="?attr/colorPrimary"
                        android:textSize="16sp"
                        android:fontFamily="@font/poppins_bold"/>
                </LinearLayout>

            </LinearLayout>



        </LinearLayout>
    </ScrollView>

</LinearLayout>