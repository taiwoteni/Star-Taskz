            <!-- Notifications-->
            <RelativeLayout
                android:id="@+id/notifications_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp">

                <androidx.cardview.widget.CardView
                    android:id="@+id/notification_icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    app:cardElevation="0dp"
                    android:backgroundTint="#1D109E15"
                    app:cardCornerRadius="@dimen/regular_value_size">
                    <ImageView
                        android:layout_width="23sp"
                        android:layout_height="23sp"
                        android:layout_margin="10sp"
                        app:tint="@color/themeColor"
                        android:src="@drawable/notifications"
                        />
                </androidx.cardview.widget.CardView>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_centerVertical="true"
                    android:layout_toEndOf="@+id/notification_icon"
                    android:textSize="@dimen/regular_font_size"
                    android:textColor="?attr/colorPrimary"
                    android:text="Notifications"
                    android:fontFamily="@font/poppins_medium"/>

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/notifications_switch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/Widget.Material3.CompoundButton.MaterialSwitch"
                    app:thumbTint="@color/white"
                    app:trackTint="@color/themeColor"
                    android:checked="true"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"/>
            </RelativeLayout>
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="15dp"
                android:layout_marginBottom="15dp"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:background="?attr/colorTertiary"/>

            <!-- Reminders-->
            <RelativeLayout
                android:id="@+id/reminders_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp">

                <androidx.cardview.widget.CardView
                    android:id="@+id/reminder_icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:backgroundTint="#1D109E15"
                    app:cardElevation="0dp"
                    app:cardCornerRadius="@dimen/regular_value_size">
                    <ImageView
                        android:layout_width="23sp"
                        android:layout_height="23sp"
                        android:layout_margin="10sp"
                        app:tint="@color/themeColor"
                        android:src="@drawable/alarm_clock"/>
                </androidx.cardview.widget.CardView>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_centerVertical="true"
                    android:layout_toEndOf="@+id/reminder_icon"
                    android:textSize="@dimen/regular_font_size"
                    android:textColor="?attr/colorPrimary"
                    android:text="Reminders"
                    android:fontFamily="@font/poppins_medium"/>

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/reminder_switch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/Widget.Material3.CompoundButton.MaterialSwitch"
                    app:thumbTint="@color/white"
                    app:trackTint="@color/themeColor"
                    android:checked="true"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"/>
            </RelativeLayout>
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="15dp"
                android:layout_marginBottom="15dp"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:background="?attr/colorTertiary"/>

            <!-- Ringtone-->
            <RelativeLayout
                android:id="@+id/ringtone_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp">

                <androidx.cardview.widget.CardView
                    android:id="@+id/ringtone_icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    app:cardElevation="0dp"
                    android:backgroundTint="#1D109E15"
                    app:cardCornerRadius="@dimen/regular_value_size">
                    <ImageView
                        android:layout_width="23sp"
                        android:layout_height="23sp"
                        android:layout_margin="10sp"
                        app:tint="@color/themeColor"
                        android:src="@drawable/music_note" />
                </androidx.cardview.widget.CardView>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_centerVertical="true"
                    android:layout_toEndOf="@+id/ringtone_icon"
                    android:textSize="@dimen/regular_font_size"
                    android:textColor="?attr/colorPrimary"
                    android:text="Ringtone"
                    android:fontFamily="@font/poppins_medium"/>

                <androidx.cardview.widget.CardView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:backgroundTint="#1D109E15"
                    app:cardElevation="0dp"
                    app:cardCornerRadius="60dp">
                    <ImageView
                        android:layout_width="@dimen/regular_icon_size"
                        android:layout_height="@dimen/regular_icon_size"
                        android:layout_margin="@dimen/regular_value_size"
                        android:src="@drawable/forward_icon"
                        app:tint="@color/themeColor"/>
                </androidx.cardview.widget.CardView>
            </RelativeLayout>
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="15dp"
                android:layout_marginBottom="15dp"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:background="?attr/colorTertiary"/>

            <!-- Logout-->
            <RelativeLayout
                android:id="@+id/logout_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginBottom="@dimen/extra_large_value_size"
                android:layout_marginEnd="20dp">

                <androidx.cardview.widget.CardView
                    android:id="@+id/logout_icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    app:cardElevation="0dp"
                    android:backgroundTint="@color/redTransparent"
                    app:cardCornerRadius="@dimen/regular_value_size">

                    <ImageView
                        android:layout_width="23sp"
                        android:layout_height="23sp"
                        android:layout_margin="10sp"
                        android:src="@drawable/logout"
                        app:tint="@color/red" />
                </androidx.cardview.widget.CardView>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_centerVertical="true"
                    android:layout_toEndOf="@+id/logout_icon"
                    android:textSize="@dimen/regular_font_size"
                    android:textColor="@color/red"
                    android:text="Logout"
                    android:fontFamily="@font/poppins_medium"/>

                <androidx.cardview.widget.CardView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:backgroundTint="@color/redTransparent"
                    app:cardElevation="0dp"
                    app:cardCornerRadius="55dp">

                    <ImageView
                        android:layout_width="@dimen/regular_icon_size"
                        android:layout_height="@dimen/regular_icon_size"
                        android:layout_margin="@dimen/regular_value_size"
                        android:src="@drawable/forward_icon"
                        app:tint="@color/red"/>
                </androidx.cardview.widget.CardView>
            </RelativeLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>