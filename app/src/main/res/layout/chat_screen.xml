<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/background"
    tools:context=".presentation.views.ChatScreen">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">
        <LinearLayout
            android:id="@+id/app_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:background="@drawable/taskz_page_header_background"
            android:paddingVertical="@dimen/medium_value_size"
            android:paddingHorizontal="@dimen/large_value_size"
            android:orientation="horizontal">
            <ImageView
                android:id="@+id/back"
                android:layout_width="27dp"
                android:layout_height="27dp"
                app:tint="?attr/colorPrimary"
                android:src="@drawable/forward_icon"
                android:layout_marginRight="@dimen/small_value_size"
                android:scaleX="0.8"
                android:scaleY="0.8"
                android:rotation="180"/>
            <FrameLayout
                android:layout_marginLeft="@dimen/regular_value_size"
                android:layout_marginRight="@dimen/medium_value_size"
                android:layout_width="48dp"
                android:layout_height="48dp">
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:gravity="center"
                    android:layout_height="match_parent">
                    <de.hdodenhof.circleimageview.CircleImageView
                        android:id="@+id/group_profile_icon"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@color/greenTransparent"
                        android:scaleType="centerCrop"/>
                    <ImageView
                        android:id="@+id/group_icon"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/hq"
                        android:padding="2sp"
                        android:scaleType="centerCrop"
                        android:layout_centerInParent="true"
                        app:tint="@color/themeColor"/>

                </RelativeLayout>
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/group_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Star Taskz HQ"
                    android:fontFamily="@font/poppins_semibold"
                    android:textColor="?attr/colorPrimary"
                    android:gravity="start"
                    android:textSize="14.5sp"/>
                <TextView
                    android:id="@+id/group_description"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="5 members"
                    android:lines="1"
                    android:ellipsize="end"
                    android:fontFamily="@font/poppins_regular"
                    android:textColor="?attr/colorSecondary"
                    android:gravity="start"
                    android:textSize="9sp"/>
            </LinearLayout>
            <ImageView
                android:visibility="gone"
                android:id="@+id/projects"
                android:layout_width="27dp"
                android:layout_height="27dp"
                app:tint="@color/themeColor"
                android:src="@drawable/task"/>




        </LinearLayout>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/chats_recycler"
            android:layout_marginTop="@dimen/regular_value_size"
            android:background="@drawable/chat_body_background"
            android:backgroundTint="?attr/colorTertiary"
            android:paddingHorizontal="@dimen/medium_value_size"
            android:paddingTop="@dimen/medium_value_size"
            tools:listitem="@layout/chats_item_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"/>
        <LinearLayout
            android:id="@+id/bottom_nav_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="25sp"
            android:gravity="center_vertical"
            android:paddingHorizontal="@dimen/medium_value_size">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:paddingVertical="10sp"
                android:paddingHorizontal="@dimen/medium_value_size"
                android:background="@drawable/chat_text_form_background"
                android:backgroundTint="?attr/colorTertiary">
                <EditText
                    android:id="@+id/message_form"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:background="@android:color/transparent"
                    android:textColor="?attr/colorPrimary"
                    android:layout_weight="1"
                    android:textCursorDrawable="@drawable/cursor_drawable"
                    android:paddingHorizontal="@dimen/regular_value_size"
                    android:gravity="center_vertical"
                    android:paddingVertical="@dimen/regular_value_size"
                    android:hint="What are your thoughts?"
                    android:textColorHint="?attr/colorSecondary"
                    android:textSize="12sp"
                    android:fontFamily="@font/poppins_medium"/>
                <ImageView
                    android:id="@+id/send_icon"
                    android:visibility="gone"
                    android:layout_marginLeft="@dimen/regular_value_size"
                    android:layout_width="32sp"
                    android:layout_height="32sp"
                    android:src="@drawable/send"
                    android:scaleType="centerCrop"
                    app:tint="@color/themeColor"/>

            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>