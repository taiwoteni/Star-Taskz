<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:gravity="center_vertical"
    android:layout_height="wrap_content"
    android:layout_marginBottom="18sp"
    android:paddingHorizontal="@dimen/large_value_size"
    android:paddingVertical="@dimen/regular_value_size">
    <FrameLayout
        android:layout_marginRight="@dimen/medium_value_size"
        android:layout_width="50dp"
        android:layout_height="50dp">
        <RelativeLayout
            android:layout_width="match_parent"
            android:gravity="center"
            android:layout_height="match_parent">
            <de.hdodenhof.circleimageview.CircleImageView
                android:id="@+id/workspace_profile_icon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@color/greenTransparent"
                android:scaleType="centerCrop"/>
            <ImageView
                android:id="@+id/group_icon"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/hq"
                android:padding="2sp"
                android:scaleType="centerCrop"
                android:layout_centerInParent="true"
                app:tint="@color/themeColor"/>

        </RelativeLayout>
    </FrameLayout>
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">
        <TextView
            android:id="@+id/group_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Star Taskz HQ"
            android:fontFamily="@font/poppins_semibold"
            android:textColor="?attr/colorPrimary"
            android:gravity="start"
            android:textSize="13.5sp"/>
        <TextView
            android:id="@+id/group_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Jones: Well noted sir"
            android:lines="1"
            android:ellipsize="end"
            android:fontFamily="@font/poppins_regular"
            android:textColor="?attr/colorSecondary"
            android:gravity="start"
            android:textSize="11.5sp"/>

    </LinearLayout>
    <TextView
        android:id="@+id/new_messages"
        android:layout_marginHorizontal="@dimen/regular_value_size"
        android:layout_width="@dimen/medium_icon_size"
        android:layout_height="@dimen/medium_icon_size"
        android:gravity="center"
        android:text="5"
        android:textSize="12sp"
        android:textColor="@color/white"
        android:fontFamily="@font/quicksand_bold"
        android:backgroundTint="@color/themeColor"
        android:background="@drawable/circle_background"/>
</LinearLayout>