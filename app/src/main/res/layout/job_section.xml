<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/background">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:scrollbars="vertical"
        android:orientation="vertical">
        <!--<com.airbnb.lottie.LottieAnimationView
            android:layout_width="match_parent"
            android:layout_height="110dp"
            app:lottie_rawRes="@raw/login_illustration"
            android:scaleType="fitCenter"
            app:lottie_autoPlay="true"
            app:lottie_loop="true"
            /> -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="What do you do?"
            android:textSize="@dimen/large_font_size"
            android:gravity="center"
            android:textColor="?attr/colorPrimary"
            android:layout_marginBottom="@dimen/small_value_size"
            android:fontFamily="@font/poppins_semibold"
            tools:ignore="HardcodedText" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Which job would be used\nfor your business account?"
            android:gravity="center"
            android:textSize="@dimen/regular_font_size"
            android:textColor="?attr/colorSecondary"
            android:layout_marginBottom="@dimen/large_value_size"
            android:fontFamily="@font/poppins_regular"
            tools:ignore="HardcodedText" />


        <com.theteam.taskz.presentation.views.TextInputFormField
            android:id="@+id/job_title_form"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/large_value_size"
            android:layout_marginTop="@dimen/large_value_size"
            android:layout_marginBottom="@dimen/large_value_size"
            app:fontFamily="@font/poppins_regular"
            app:hint="Job Title"
            app:isPassword="false"
            android:inputType="text"
            app:hintColor="?attr/colorSecondary"
            app:prefixIcon="@drawable/work"/>
        <com.theteam.taskz.presentation.views.TextInputFormField
            android:id="@+id/job_description_form"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/large_value_size"
            android:layout_marginBottom="@dimen/extra_large_value_size"
            app:fontFamily="@font/poppins_regular"
            app:hintColor="?attr/colorSecondary"
            android:inputType="textPersonName"
            app:hint="Job Description"
            app:prefixIcon="@drawable/description"/>
        <!--        <com.theteam.taskz.presentation.views.TextInputFormField-->
        <!--            android:id="@+id/dob_form"-->
        <!--            android:layout_width="match_parent"-->
        <!--            android:layout_height="wrap_content"-->
        <!--            android:layout_marginHorizontal="@dimen/large_value_size"-->
        <!--            android:layout_marginBottom="@dimen/extra_large_value_size"-->
        <!--            app:fontFamily="@font/poppins_regular"-->
        <!--            app:hintColor="?attr/colorSecondary"-->
        <!--            android:inputType="none"-->
        <!--            app:hint="Date Of Birth"-->

        <!--            app:prefixIcon="@drawable/calendar"/>-->

        <!-- Login Button Widget-->


        <com.theteam.taskz.presentation.views.LoadableButton
            android:id="@+id/loadable_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/large_value_size"
            android:layout_marginHorizontal="@dimen/large_value_size"
            app:text="NEXT"
            app:backgroundColor="@color/themeColor"/>

        <!-- Divider Widget-->


        <!-- Text to navigate to account category page-->
        <com.theteam.taskz.presentation.views.UnderlineTextView
            android:id="@+id/back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="Back"
            android:fontFamily="@font/poppins_regular"
            android:textColor="@color/themeColor"
            android:textStyle="normal"
            tools:ignore="HardcodedText" />
    </LinearLayout>


</androidx.coordinatorlayout.widget.CoordinatorLayout>