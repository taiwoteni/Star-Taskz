<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/background">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scrollbars="vertical"
        android:gravity="center"
        android:orientation="vertical">
        <!--<com.airbnb.lottie.LottieAnimationView
            android:layout_width="match_parent"
            android:layout_height="110dp"
            app:lottie_rawRes="@raw/login_illustration"
            android:scaleType="fitCenter"
            app:lottie_autoPlay="true"
            app:lottie_loop="true"
            /> -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="...And Finally"
            android:gravity="center"
            android:textSize="@dimen/large_font_size"
            android:textColor="?attr/colorPrimary"
            android:layout_marginBottom="@dimen/small_value_size"
            android:fontFamily="@font/poppins_semibold"
            tools:ignore="HardcodedText" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Your Login credentials"
            android:gravity="center"
            android:textSize="@dimen/regular_font_size"
            android:textColor="?attr/colorSecondary"
            android:layout_marginBottom="@dimen/extra_large_value_size"
            android:fontFamily="@font/poppins_regular"
            tools:ignore="HardcodedText" />


        <com.theteam.taskz.presentation.views.TextInputFormField
            android:id="@+id/email_form"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/large_value_size"
            android:layout_marginTop="@dimen/large_value_size"
            android:layout_marginBottom="@dimen/large_value_size"
            app:fontFamily="@font/poppins_regular"
            app:hint="Enter Email"
            app:isPassword="false"
            android:inputType="textEmailAddress"
            app:hintColor="?attr/colorSecondary"
            app:prefixIcon="@drawable/email"/>
        <com.theteam.taskz.presentation.views.TextInputFormField
            android:id="@+id/password_form"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/large_value_size"
            android:layout_marginBottom="@dimen/large_value_size"
            app:fontFamily="@font/poppins_regular"
            app:hintColor="?attr/colorSecondary"
            android:inputType="textPassword"
            app:isPassword="true"
            app:hint="Enter Password"
            app:prefixIcon="@drawable/padlock"/>
        <com.theteam.taskz.presentation.views.TextInputFormField
            android:id="@+id/confirm_password_form"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/large_value_size"
            android:layout_marginBottom="@dimen/extra_large_value_size"
            app:fontFamily="@font/poppins_regular"
            app:hintColor="?attr/colorSecondary"
            android:inputType="textPassword"
            app:isPassword="true"
            app:hint="Confirm Password"
            app:prefixIcon="@drawable/padlock"/>

        <!-- Login Button Widget-->


        <com.theteam.taskz.presentation.views.LoadableButton
            android:id="@+id/loadable_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/large_value_size"
            android:layout_marginHorizontal="@dimen/large_value_size"
            app:text="REGISTER"
            app:backgroundColor="@color/themeColor"/>

        <!-- Text to navigate to select category page-->
        <com.theteam.taskz.presentation.views.UnderlineTextView
            android:id="@+id/back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="back"
            android:fontFamily="@font/poppins_regular"
            android:textColor="@color/themeColor"
            android:textStyle="normal"
            tools:ignore="HardcodedText" />
    </LinearLayout>


</androidx.coordinatorlayout.widget.CoordinatorLayout>