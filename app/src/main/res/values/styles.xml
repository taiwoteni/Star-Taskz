<resources>

    <style name="Widget.Taskz.AppWidget.Container" parent="android:Widget">
        <item name="android:id">@android:id/background</item>
        <item name="android:background">?android:attr/colorBackground</item>
    </style>

    <style name="Widget.Taskz.AppWidget.InnerView" parent="android:Widget">
        <item name="android:background">?android:attr/colorBackground</item>
        <item name="android:textColor">?android:attr/textColorPrimary</item>
    </style>

    <style name="CustomBottomSheetDialog" parent="Theme.Design.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/CustomBottomSheetStyle</item>
    </style>

    <style name="CustomBottomSheetStyle" parent="Widget.Design.BottomSheet.Modal">
        <item name="shapeAppearanceOverlay">@style/BottomSheetShapeAppearance</item>
    </style>

    <style name="BottomSheetShapeAppearance">
        <item name="boxCornerRadiusTopStart">@dimen/large_value_size</item>
        <item name="boxCornerRadiusTopEnd">@dimen/large_value_size</item>
        <item name="cornerRadius">@dimen/large_value_size</item>
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/large_value_size</item> <!-- Adjust the corner size as needed -->
    </style>

    <!-- Text appearance for unselected tabs -->
    <style name="TabUnselectedText">
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">@font/poppins_medium</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">?attr/colorSecondary</item> <!-- gray color -->
    </style>

    <!-- Text appearance for selected tabs -->
    <style name="TabSelectedText">
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">@font/poppins_semibold</item>
    <item name="android:textSize">15sp</item>
    <item name="android:textColor">@color/themeColor</item>
    </style>
</resources>